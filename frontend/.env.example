# Supabase project URL and publishable (anon) key — public values, safe in a browser bundle.
# Get these from the Supabase project's API settings. Never put the secret/service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Spring Boot backend base URL
VITE_API_BASE_URL=http://localhost:8080
